create or replace view DEV_ADMS.DP_012_NETWORK_PERFORMANCE.TEMP_PLANNED_OUTAGE_ADVERTISING_PERFORMANCE(
	DIM_PLANNED_OUTAGE_SECTION_KEY,
	SECTION_ID,
	JOB_ID,
	JOB_NUMBER,
	HVSPEC_BLOCK_NAME,
	PROPOSED_INCIDENT_START_DATETIME,
	PROPOSED_INCIDENT_END_DATETIME,
	ALTERNATE_INCIDENT_START_DATETIME,
	ALTERNATE_INCIDENT_END_DATETIME,
	PROPOSED_INCIDENT_DURATION_MINUTES,
	POSTPONE_NOTICE_DATETIME,
	CANCEL_NOTICE_DATETIME,
	INITIAL_NOTICE_DATETIME,
	PRIMARY_BLOCK_FLAG,
	LAST_KNOWN_ADVERTISING_STATUS_DESCRIPTION,
	LAST_KNOWN_ADVERTISING_COMPLETED_DATETIME,
	LAST_KNOWN_ADVERTISING_METHOD_DESCRIPTION,
	ROW_CREATE_DATETIME,
	ROW_UPDATE_DATETIME,
	LOCATION_DESCRIPTION,
	SUBURB_NAME,
	BLOCK_STATUS_DESCRIPTION,
	FIELD_SERVICE_PROVIDER_NAME,
	PROPOSAL_CANCELLED_REASON_INTERNAL,
	PROPOSAL_CANCELLED_REASON_EXTERNAL,
	PROPOSAL_CANCELLED_COMMENTS,
	BLOCK_CANCELLED_REASON_INTERNAL,
	BLOCK_CANCELLED_REASON_EXTERNAL,
	BLOCK_CANCELLED_COMMENTS,
	BLOCK_POSTPONED_REASON_INTERNAL,
	BLOCK_POSTPONED_REASON_EXTERNAL,
	BLOCK_POSTPONED_COMMENTS,
	VOLTAGE_LEVEL_CODE,
	ADVERTISED_NOTICE_POSTPONED_DATETIME,
	ADVERTISED_NOTICE_CANCELLED_DATETIME,
	POSTPONED_REASON_CATEGORY_DESCRIPTION,
	CANCELLED_REASON_CATEGORY_DESCRIPTION,
	CANCELLED_PROPOSAL_REASON_CATEGORY_DESCRIPTION,
	NOTICE_PLANNING_APPROVED_OUTAGE_CENTRE_DATETIME,
	NOTICE_PLANNING_APPROVED_OUTAGE_CENTRE_VERSION_DESCRIPTION,
	POSTPONED_OUTAGE_CENTRE_VERSION_DESCRIPTION,
	POSTPONED_OUTAGE_CENTRE_DATETIME,
	CANCELLED_OUTAGE_CENTRE_DATETIME,
	CANCELLED_OUTAGE_CENTRE_VERSION_DESCRIPTION,
	NOTICE_PLANNING_APPROVED_OUTAGE_CENTRE_DELAY_MINUTES,
	NOTICE_POSTPONED_OUTAGE_CENTRE_DELAY_MINUTES,
	NOTICE_CANCELLED_OUTAGE_CENTRE_DELAY_MINUTES,
	ADMS_NOTICE_CANCELLED_DATETIME,
	ADMS_NOTICE_POSTPONED_DATETIME,
	ADMS_NOTICE_PLANNING_APPROVED_DATETIME,
	SYSTEM_CREATE_DATE,
	SYSTEM_UPDATE_DATE,
	ROW_SOURCE_SYSTEM_NAME,
	DIM_OUTAGE_INCIDENT_KEY,
	CALENDAR_DAYS_ADVERTISING_TO_OUTAGE,
	HOLIDAYS_ADVERTISING_TO_OUTAGE,
	HOLIDAYS_APPROVAL_TO_14_DAYS_BEFORE_OUTAGE,
	CALENDAR_DAYS_APPROVAL_TO_14_DAYS_BEFORE_OUTAGE,
	CALENDAR_DAYS_APPROVAL_TO_OUTAGE,
	HOLIDAYS_APPROVAL_TO_OUTAGE
) as
WITH calendar_days AS (
    SELECT
        CALENDAR_DATE,
        IS_AUCKLAND_OFFICE_OPEN_FLAG
    FROM DEV_ADMS.CURATED_DEFAULT.DIM_OUTAGE_INCIDENT_START_DATE
),
base AS (
    SELECT
        d.*,
        f.DIM_OUTAGE_INCIDENT_KEY
    FROM DEV_ADMS.DP_012_NETWORK_PERFORMANCE.DIM_PLANNED_OUTAGE_SECTION d
    LEFT JOIN DEV_ADMS.DP_012_NETWORK_PERFORMANCE.FACT_SAIDI_PLANNED f
        ON d.DIM_PLANNED_OUTAGE_SECTION_KEY = f.DIM_PLANNED_OUTAGE_SECTION_KEY
    WHERE d.JOB_NUMBER <> 'Unknown'
    QUALIFY ROW_NUMBER() OVER (
        PARTITION BY d.JOB_NUMBER
        ORDER BY d.ROW_UPDATE_DATETIME DESC
    ) = 1
)
SELECT
    b.*,

    DATEDIFF(
        DAY,
        b.LAST_KNOWN_ADVERTISING_COMPLETED_DATETIME::DATE,
        b.PROPOSED_INCIDENT_START_DATETIME::DATE
    ) AS CALENDAR_DAYS_ADVERTISING_TO_OUTAGE,

    (
        SELECT COUNT(*)
        FROM calendar_days c
        WHERE c.IS_AUCKLAND_OFFICE_OPEN_FLAG = FALSE
          AND c.CALENDAR_DATE > b.LAST_KNOWN_ADVERTISING_COMPLETED_DATETIME::DATE
          AND c.CALENDAR_DATE <= b.PROPOSED_INCIDENT_START_DATETIME::DATE
    ) AS HOLIDAYS_ADVERTISING_TO_OUTAGE,

    (
        SELECT COUNT(*)
        FROM calendar_days c
        WHERE c.IS_AUCKLAND_OFFICE_OPEN_FLAG = FALSE
          AND c.CALENDAR_DATE > b.NOTICE_PLANNING_APPROVED_OUTAGE_CENTRE_DATETIME::DATE
          AND c.CALENDAR_DATE <= DATEADD(
                DAY,
                -14,
                b.PROPOSED_INCIDENT_START_DATETIME::DATE
          )
    ) AS HOLIDAYS_APPROVAL_TO_14_DAYS_BEFORE_OUTAGE,

    DATEDIFF(
        DAY,
        b.NOTICE_PLANNING_APPROVED_OUTAGE_CENTRE_DATETIME::DATE,
        DATEADD(
            DAY,
            -14,
            b.PROPOSED_INCIDENT_START_DATETIME::DATE
        )
    ) AS CALENDAR_DAYS_APPROVAL_TO_14_DAYS_BEFORE_OUTAGE,

    DATEDIFF(
        DAY,
        b.NOTICE_PLANNING_APPROVED_OUTAGE_CENTRE_DATETIME::DATE,
        b.PROPOSED_INCIDENT_START_DATETIME::DATE
    ) AS CALENDAR_DAYS_APPROVAL_TO_OUTAGE,

    (
        SELECT COUNT(*)
        FROM calendar_days c
        WHERE c.IS_AUCKLAND_OFFICE_OPEN_FLAG = FALSE
          AND c.CALENDAR_DATE > b.NOTICE_PLANNING_APPROVED_OUTAGE_CENTRE_DATETIME::DATE
          AND c.CALENDAR_DATE <= b.PROPOSED_INCIDENT_START_DATETIME::DATE
    ) AS HOLIDAYS_APPROVAL_TO_OUTAGE

FROM base b;
