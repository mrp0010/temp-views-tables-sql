create or replace view DEV_ADMS.DP_012_NETWORK_PERFORMANCE.TEMP_CUSTOMER_ACTIVITY_FILTER(
	SERVICE_REQUEST_NUMBER,
	APPOINTMENT_DATETIME,
	ONSITE_TO_OFFSITE_MINUTES,
	HAS_APPOINTMENT_FLAG,
	VALID_DURATION_FLAG
) as
WITH ranked_activities AS (
    SELECT
        dsr.SERVICE_REQUEST_NUMBER,
        dca.APPOINTMENT_DATETIME,
        dca.ON_SITE_STARTED_DATETIME,
        dca.TIME_OFF_SITE_DATETIME,

        DATEDIFF(MINUTE, dca.ON_SITE_STARTED_DATETIME, dca.TIME_OFF_SITE_DATETIME) 
            AS ONSITE_TO_OFFSITE_MINUTES,

        CASE 
            WHEN dca.APPOINTMENT_DATETIME IS NOT NULL THEN 1 
            ELSE 0 
        END AS HAS_APPOINTMENT_FLAG,

        CASE 
            WHEN dca.ON_SITE_STARTED_DATETIME IS NOT NULL
             AND dca.TIME_OFF_SITE_DATETIME IS NOT NULL
             AND DATEDIFF(MINUTE, dca.ON_SITE_STARTED_DATETIME, dca.TIME_OFF_SITE_DATETIME) > 0
            THEN 1 
            ELSE 0 
        END AS VALID_DURATION_FLAG,

        ROW_NUMBER() OVER (
            PARTITION BY dsr.SERVICE_REQUEST_NUMBER
            ORDER BY dca.CREATED_DATETIME ASC
        ) AS rn

    FROM EDW_TEST_CURATED.CUSTOMER.FACT_CUSTOMER_ACTIVITY fca
    JOIN EDW_TEST_CURATED.CUSTOMER.DIM_CUSTOMER_ACTIVITY dca
        ON fca.DIM_CUSTOMER_ACTIVITY_KEY = dca.DIM_CUSTOMER_ACTIVITY_KEY
    JOIN EDW_TEST_CURATED.CUSTOMER.DIM_SERVICE_REQUEST dsr
        ON fca.DIM_SERVICE_REQUEST_KEY = dsr.DIM_SERVICE_REQUEST_KEY
    JOIN EDW_TEST_CURATED.CUSTOMER.DIM_CUSTOMER_ACTIVITY_TYPE dcat
        ON fca.DIM_CUSTOMER_ACTIVITY_TYPE_KEY = dcat.DIM_CUSTOMER_ACTIVITY_TYPE_KEY

    WHERE dsr.SERVICE_REQUEST_NUMBER <> 'Unknown'
      AND dcat.TYPE = 'Assign Crew'
      AND dcat.CATEGORY_NAME = 'Field Engineer Activity'
)

SELECT
    SERVICE_REQUEST_NUMBER,
    APPOINTMENT_DATETIME,
    ONSITE_TO_OFFSITE_MINUTES,
    HAS_APPOINTMENT_FLAG,
    VALID_DURATION_FLAG
FROM ranked_activities
WHERE rn = 1;
